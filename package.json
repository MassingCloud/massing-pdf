{
  "name": "@massingcloud/pdf-viewer",
  "version": "0.1.0",
  "description": "Framework-agnostic PDF drawing viewer, markup, measurement and pinning engine for AEC — plugin kernel, structured annotations, XFDF/BCF interchange. Extracted from Massing, built to be reintegrated.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MassingCloud/massing-pdf.git"
  },
  "homepage": "https://github.com/MassingCloud/massing-pdf#readme",
  "bugs": {
    "url": "https://github.com/MassingCloud/massing-pdf/issues"
  },
  "keywords": [
    "pdf",
    "pdfjs",
    "annotation",
    "markup",
    "takeoff",
    "construction",
    "aec",
    "bcf",
    "xfdf",
    "bluebeam"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/massing-pdf.js",
  "module": "./dist/massing-pdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/massing-pdf.js"
    },
    "./style.css": "./dist/massing-pdf.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:all": "npm run check && npm run test:e2e",
    "check:licences": "node scripts/check-licences.mjs",
    "check:package": "node scripts/check-package.mjs",
    "demo:build": "vite build --mode demo",
    "dev": "vite",
    "lint": "eslint src demo e2e",
    "prepublishOnly": "npm run check && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.23.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.0",
    "ppu-paddle-ocr": "^6.0.0",
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "ppu-paddle-ocr": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.2",
    "eslint": "9.39.5",
    "happy-dom": "^15.11.7",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "ppu-paddle-ocr": "^6.2.0",
    "tesseract.js": "^7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.18"
  }
}
