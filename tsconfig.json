{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The e2e suite imports the library inside `page.evaluate` using the dev server's own URL.
    // Mapping it here means those blocks are fully typechecked rather than being `any` islands.
    "baseUrl": ".",
    "paths": { "/src/*": ["./src/*"], "/e2e/*": ["./e2e/*"] },
    // Those URLs carry a `.ts` extension because that is what the dev server serves. Nothing is
    // emitted from this config, so allowing the extension costs nothing.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "demo", "test", "e2e", "vite.config.ts", "vitest.config.ts"]
}
